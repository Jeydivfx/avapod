<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/player_root_view" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/player_bg_gradient" android:layoutDirection="rtl">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
            <include android:id="@+id/common_toolbar" layout="@layout/layout_common_toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <androidx.cardview.widget.CardView android:layout_width="180dp" android:layout_height="180dp" android:layout_marginTop="16dp" app:cardCornerRadius="24dp">
                <ImageView android:id="@+id/player_img_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no" android:src="@drawable/placeholder_podcast" />
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/player_txt_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:textColor="@color/text_white" android:textSize="20sp" android:fontFamily="@font/vazir_bold" android:maxLines="2" android:ellipsize="end" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
            <TextView android:id="@+id/player_txt_podcast" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="@color/text_gray" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/vazir_regular" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
            <com.avapod.app.WaveformView android:id="@+id/player_waveform" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:focusable="true" android:contentDescription="@string/accessibility_seek" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layoutDirection="ltr">
                <TextView android:id="@+id/txt_current_time" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/text_gray" android:textSize="14sp" android:textDirection="ltr" android:fontFamily="@font/vazir_regular" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
                <TextView android:id="@+id/txt_total_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_gray" android:textSize="14sp" android:textDirection="ltr" android:fontFamily="@font/vazir_regular" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:layoutDirection="ltr">
                <TextView android:id="@+id/btn_speed" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:gravity="center" android:textColor="@color/text_white" android:textSize="14sp" android:background="?attr/selectableItemBackground" android:contentDescription="@string/accessibility_speed" android:fontFamily="@font/vazir_regular" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
                <ImageView android:id="@+id/btn_rewind_15" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:padding="12dp" android:src="@drawable/ic_replay_15" app:tint="@color/text_white" android:background="?attr/selectableItemBackground" android:contentDescription="@string/accessibility_rewind" />
                <ImageView android:id="@+id/btn_play_pause" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="64dp" android:padding="14dp" android:src="@drawable/ic_play_arrow" app:tint="@color/primary_blue" android:background="?attr/selectableItemBackground" android:contentDescription="@string/accessibility_play" />
                <ImageView android:id="@+id/btn_forward_30" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:padding="12dp" android:src="@drawable/ic_forward_30" app:tint="@color/text_white" android:background="?attr/selectableItemBackground" android:contentDescription="@string/accessibility_forward" />
                <ImageView android:id="@+id/btn_sleep_timer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:padding="14dp" android:src="@drawable/ic_access_time" app:tint="@color/text_white" android:background="?attr/selectableItemBackground" android:contentDescription="@string/accessibility_sleep" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout android:id="@+id/banner_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="12dp" />
</LinearLayout>