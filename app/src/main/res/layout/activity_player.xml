<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/player_root_view"
    android:background="@drawable/player_bg_gradient"
    android:padding="12dp">

    <include
        android:id="@+id/common_toolbar"
        layout="@layout/layout_common_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_cover"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_below="@id/common_toolbar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp">
        <ImageView
            android:id="@+id/player_img_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_podcast" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/info_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/card_cover"
        android:layout_marginTop="24dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/player_txt_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:fontFamily="@font/vazir_bold"
            android:gravity="center"
            android:text="@string/player_txt_title"
            android:maxLines="1"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:id="@+id/player_txt_podcast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_gray"
            android:textSize="15sp"
            android:fontFamily="@font/vazir_regular"
            android:gravity="center"
            android:text="@string/player_txt_podcast" />
    </LinearLayout>

    <com.avapod.app.WaveformView
        android:id="@+id/player_waveform"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@id/info_layout"
        android:layout_marginTop="32dp"/>

    <RelativeLayout
        android:id="@+id/time_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/player_waveform"
        android:layout_marginTop="8dp">
        <TextView android:id="@+id/txt_current_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/txt_default_time" android:textColor="@color/text_gray" android:textSize="12sp" />
        <TextView android:id="@+id/txt_total_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="@string/txt_default_time" android:textColor="@color/text_gray" android:textSize="12sp" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/controls_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/time_layout"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal">


        <TextView
            android:id="@+id/btn_speed"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_dark"
            android:gravity="center"
            android:text="@string/btn_speed_default"
            android:textColor="@color/text_white"
            android:fontFamily="@font/vazir_bold"
            android:textSize="10sp"/>


        <ImageView
            android:id="@+id/btn_rewind_15"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="20dp"
            android:src="@drawable/ic_replay_15"
            app:tint="@color/text_white" />

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="20dp">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_outline_circle"
                app:backgroundTint="@color/text_white"/>
            <ImageView
                android:id="@+id/btn_play_pause"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_arrow"
                app:tint="@color/primary_blue" />
        </FrameLayout>

        <ImageView
            android:id="@+id/btn_forward_30"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="20dp"
            android:src="@drawable/ic_forward_30"
            app:tint="@color/text_white" />


        <ImageView
            android:id="@+id/btn_sleep_timer"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_dark"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_access_time"
            app:tint="@color/text_white" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent" />

</RelativeLayout>