<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/player_root_view" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/player_bg_gradient" android:layoutDirection="rtl">
  <include android:id="@+id/common_toolbar" layout="@layout/layout_common_toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" />
  <androidx.core.widget.NestedScrollView android:id="@+id/player_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:id="@+id/player_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingVertical="8dp">
      <androidx.cardview.widget.CardView android:id="@+id/player_cover_frame" android:layout_width="184dp" android:layout_height="184dp" android:layout_marginTop="4dp" app:cardCornerRadius="24dp">
        <ImageView android:id="@+id/player_img_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no" android:src="@drawable/placeholder_podcast" />
      </androidx.cardview.widget.CardView>
      <TextView android:id="@+id/player_txt_title" android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:textColor="@color/text_white" android:textSize="16sp" android:fontFamily="@font/vazir_bold" android:maxLines="2" android:ellipsize="end" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
      <TextView android:id="@+id/player_txt_podcast" android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:textColor="@color/text_gray" android:textSize="@dimen/type_label" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/vazir_regular" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
      <com.avapod.app.WaveformView android:id="@+id/player_waveform" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="24dp" android:focusable="true" android:contentDescription="@string/accessibility_seek" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layoutDirection="ltr">
        <TextView android:id="@+id/txt_current_time" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/text_gray" android:textSize="12sp" android:textDirection="ltr" android:fontFamily="@font/vazir_regular" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
        <TextView android:id="@+id/txt_total_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_gray" android:textSize="12sp" android:textDirection="ltr" android:fontFamily="@font/vazir_regular" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:layoutDirection="ltr">
        <ImageView android:id="@+id/btn_shuffle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="10dp" android:src="@drawable/ic_player_shuffle" app:tint="@color/text_gray" android:background="?attr/selectableItemBackground" android:contentDescription="@string/btn_shuffle" android:focusable="true" android:visibility="gone" />
        <ImageView android:id="@+id/btn_previous_episode" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="8dp" android:src="@drawable/ic_episode_previous" app:tint="@color/text_white" android:background="?attr/selectableItemBackground" android:contentDescription="@string/previous_episode" android:enabled="false" android:alpha="0.3" />
        <ImageView android:id="@+id/btn_rewind_15" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="8dp" android:src="@drawable/ic_replay_15" app:tint="@color/text_white" android:background="?attr/selectableItemBackground" android:contentDescription="@string/accessibility_rewind" />
        <ImageView android:id="@+id/btn_play_pause" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_play_arrow" app:tint="@android:color/white" android:background="@drawable/bg_player_play_button" android:contentDescription="@string/accessibility_play" />
        <ImageView android:id="@+id/btn_forward_30" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="8dp" android:src="@drawable/ic_forward_30" app:tint="@color/text_white" android:background="?attr/selectableItemBackground" android:contentDescription="@string/accessibility_forward" />
        <ImageView android:id="@+id/btn_next_episode" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="8dp" android:src="@drawable/ic_episode_next" app:tint="@color/text_white" android:background="?attr/selectableItemBackground" android:contentDescription="@string/next_episode" android:enabled="false" android:alpha="0.3" />
        <ImageView android:id="@+id/btn_repeat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="10dp" android:src="@drawable/ic_player_repeat" app:tint="@color/text_gray" android:background="?attr/selectableItemBackground" android:contentDescription="@string/btn_repeat" android:focusable="true" android:visibility="gone" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="4dp" android:padding="8dp" android:gravity="center_vertical" android:layoutDirection="ltr" android:background="@drawable/bg_settings_card">
        <TextView android:id="@+id/btn_speed" android:maxLines="1" android:ellipsize="end" android:drawablePadding="6dp" android:drawableTop="@drawable/ic_player_speed" android:includeFontPadding="false" android:drawableTint="@color/text_gray" android:paddingTop="2dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:gravity="center" android:textColor="@color/text_white" android:textSize="12sp" android:background="?attr/selectableItemBackground" android:contentDescription="@string/accessibility_speed" android:fontFamily="@font/vazir_regular" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
        <View android:layout_width="1dp" android:layout_height="34dp" android:background="@color/line_divider_bg" android:importantForAccessibility="no" />
        <LinearLayout android:id="@+id/sleep_timer_action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:orientation="vertical" android:gravity="center" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:contentDescription="@string/accessibility_sleep">
          <ImageView android:id="@+id/btn_sleep_timer" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_sleep_moon" app:tint="@color/text_white"  android:contentDescription="@string/accessibility_sleep" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/accessibility_sleep" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="6dp" android:textSize="12sp" android:textColor="@color/text_gray" android:fontFamily="@font/vazir_regular" />
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="34dp" android:background="@color/line_divider_bg" android:importantForAccessibility="no" />
        <TextView android:id="@+id/btn_add_playlist" android:maxLines="1" android:ellipsize="end" android:drawablePadding="6dp" android:drawableTop="@drawable/ic_playlist_add" android:includeFontPadding="false" android:drawableTint="@color/accent_cyan" android:paddingTop="2dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:gravity="center" android:text="@string/playlist_add" android:textColor="@color/accent_cyan" android:textSize="12sp" android:fontFamily="@font/vazir_bold" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
      </LinearLayout>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
  <LinearLayout android:id="@+id/banner_container" android:layout_width="match_parent" android:layout_height="74dp" android:layout_marginTop="24dp" android:layout_marginBottom="16dp" android:orientation="vertical" android:gravity="center_horizontal">
    <TextView android:layout_width="wrap_content" android:layout_height="24dp" android:text="@string/advertisement_label" android:textColor="@color/text_gray" android:textSize="@dimen/type_caption" android:gravity="center" android:fontFamily="@font/vazir_regular" />
    <com.appodeal.ads.BannerView android:id="@+id/appodeal_banner" android:layout_width="match_parent" android:layout_height="50dp" />
  </LinearLayout>
</LinearLayout>