<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_dark" android:padding="12dp" android:layoutDirection="rtl">
    <include android:id="@+id/common_toolbar" layout="@layout/layout_common_toolbar" />
    <TextView android:id="@+id/txt_admin_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/common_toolbar" android:layout_marginTop="16dp" android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:fontFamily="@font/vazir_bold" android:gravity="right" android:text="@string/title_admin_dashboard" android:textColor="@color/text_white" android:textDirection="rtl" android:textSize="20sp" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
    <EditText android:id="@+id/admin_search" android:layout_width="match_parent" android:layout_height="52dp" android:layout_below="@id/txt_admin_title" android:layout_marginTop="12dp" android:background="@drawable/bg_settings_card" android:paddingHorizontal="14dp" android:drawableStart="@drawable/ic_search" android:drawableTint="@color/text_gray" android:drawablePadding="10dp" android:hint="@string/admin_search_hint" android:inputType="text" android:imeOptions="actionSearch" android:singleLine="true" android:gravity="start|center_vertical" android:textColor="@color/text_white" android:textColorHint="@color/text_gray" android:textSize="14sp" android:fontFamily="@font/vazir_regular" app:fontFamily="@font/vazir_regular" />
    <TextView android:id="@+id/admin_search_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/admin_search" android:padding="16dp" android:visibility="gone" android:text="@string/admin_search_empty" android:textColor="@color/text_gray" android:gravity="center" android:fontFamily="@font/vazir_regular" app:fontFamily="@font/vazir_regular" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_admin_podcasts" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_above="@id/btn_add_new_podcast" android:layout_below="@id/admin_search" android:layout_marginTop="12dp" android:clipToPadding="false" android:paddingBottom="20dp" />
    <Button android:id="@+id/btn_add_new_podcast" android:layout_width="match_parent" android:layout_height="55dp" android:layout_alignParentBottom="true" android:layout_margin="12dp" android:backgroundTint="@color/primary_blue" android:fontFamily="@font/vazir_bold" android:text="@string/btn_add_new_podcast" android:textColor="@color/on_primary" android:textSize="16sp" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
</RelativeLayout>
