<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="12dp">

    <include
        android:id="@+id/common_toolbar"
        layout="@layout/layout_common_toolbar" />

    <TextView
        android:id="@+id/txt_admin_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/common_toolbar"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/vazir_bold"
        android:gravity="right"
        android:text="@string/title_admin_dashboard"
        android:textColor="@color/text_white"
        android:textDirection="rtl"
        android:textSize="20sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_admin_podcasts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btn_add_new_podcast"
        android:layout_below="@id/txt_admin_title"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp" />

    <Button
        android:id="@+id/btn_add_new_podcast"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="12dp"
        android:backgroundTint="@color/primary_blue"
        android:fontFamily="@font/vazir_bold"
        android:text="@string/btn_add_new_podcast"
        android:textColor="@color/text_white"
        android:textSize="16sp" />

</RelativeLayout>