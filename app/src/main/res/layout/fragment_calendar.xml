<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="56dp"
        android:paddingBottom="16dp">

        <!-- Header with Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_calendar"
                android:background="@drawable/bg_circle_gradient_blue"
                android:padding="6dp"
                app:tint="@color/text_white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/vazir_bold"
                android:text="@string/calendar_title"
                android:textColor="@color/text_white"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Month and Year Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:background="@color/surface_dark"
            android:paddingVertical="10dp"
            android:paddingHorizontal="12dp"
            app:cornerRadius="12dp">

            <ImageView
                android:id="@+id/btn_prev_month"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_arrow_back"
                android:padding="6dp"
                android:background="@drawable/bg_circle_icon"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/prev_month" />

            <TextView
                android:id="@+id/txt_month_year"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/vazir_bold"
                android:text="شهریور ۱۴۰۳"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:gravity="center" />

            <ImageView
                android:id="@+id/btn_next_month"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_arrow_right"
                android:padding="6dp"
                android:background="@drawable/bg_circle_icon"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/next_month" />
        </LinearLayout>

        <!-- Three Dates -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:background="@color/surface_dark"
            android:padding="10dp"
            app:cornerRadius="12dp">

            <!-- Shamsi -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazir_regular"
                    android:text="@string/calendar_shamsi"
                    android:textColor="@color/text_gray"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/txt_shamsi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/vazir_bold"
                    android:text="۱۴۰۳/۰۴/۱۷"
                    android:textColor="@color/text_white"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:background="#2A2A4A" />

            <!-- Miladi -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazir_regular"
                    android:text="@string/calendar_miladi"
                    android:textColor="@color/text_gray"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/txt_miladi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/vazir_bold"
                    android:text="2024/07/08"
                    android:textColor="@color/accent_cyan"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:background="#2A2A4A" />

            <!-- Ghamari -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazir_regular"
                    android:text="@string/calendar_ghamari"
                    android:textColor="@color/text_gray"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/txt_ghamari"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/vazir_bold"
                    android:text="۱۴۴۵/۰۱/۰۱"
                    android:textColor="#FFD700"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Event Section -->
        <TextView
            android:id="@+id/txt_event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/vazir_regular"
            android:text="@string/event_no_event"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            android:gravity="center"
            android:background="@color/surface_dark"
            android:padding="10dp"
            app:cornerRadius="8dp" />

        <!-- Week Days Header -->
        <GridLayout
            android:id="@+id/grid_weekdays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="7"
            android:rowCount="1"
            android:layout_marginBottom="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:fontFamily="@font/vazir_bold"
                android:text="@string/weekday_shanbe"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:fontFamily="@font/vazir_bold"
                android:text="@string/weekday_yekshanbe"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:fontFamily="@font/vazir_bold"
                android:text="@string/weekday_doshanbe"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:fontFamily="@font/vazir_bold"
                android:text="@string/weekday_seshanbe"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:fontFamily="@font/vazir_bold"
                android:text="@string/weekday_chaharshanbe"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:fontFamily="@font/vazir_bold"
                android:text="@string/weekday_panjshanbe"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:fontFamily="@font/vazir_bold"
                android:text="@string/weekday_jome"
                android:textColor="@color/red"
                android:textSize="12sp" />
        </GridLayout>

        <!-- Days Grid -->
        <GridLayout
            android:id="@+id/grid_days"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:columnCount="7"
            android:rowCount="6"
            android:background="@color/surface_dark"
            android:padding="8dp"
            android:visibility="visible"
            app:cornerRadius="12dp" />

        <!-- Today Button -->
        <Button
            android:id="@+id/btn_today"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="@font/vazir_bold"
            android:text="@string/btn_today"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:elevation="2dp" />

    </LinearLayout>

</FrameLayout>