<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_menu"
    android:orientation="vertical"
    android:paddingBottom="24dp"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#9BA3B2"
        android:alpha="0.3"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sleep_timer_title"
        android:textColor="@color/text_white"
        android:fontFamily="@font/vazir_bold"
        android:textSize="16sp"
        android:gravity="right"
        android:layout_marginBottom="12dp"
        android:paddingHorizontal="8dp"/>

    <TextView android:id="@+id/timer_off" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sleep_timer_off" android:textColor="@color/text_gray" android:fontFamily="@font/vazir_regular" android:textSize="14sp" android:gravity="right" android:padding="14dp" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true"/>
    <TextView android:id="@+id/timer_15" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sleep_timer_15_min" android:textColor="@color/text_white" android:fontFamily="@font/vazir_regular" android:textSize="14sp" android:gravity="right" android:padding="14dp" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true"/>
    <TextView android:id="@+id/timer_30" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sleep_timer_30_min" android:textColor="@color/text_white" android:fontFamily="@font/vazir_regular" android:textSize="14sp" android:gravity="right" android:padding="14dp" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true"/>
    <TextView android:id="@+id/timer_60" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sleep_timer_60_min" android:textColor="@color/text_white" android:fontFamily="@font/vazir_regular" android:textSize="14sp" android:gravity="right" android:padding="14dp" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true"/>

</LinearLayout>