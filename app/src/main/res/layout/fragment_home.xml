<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:ns1="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_dark" android:layoutDirection="rtl">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipe_refresh_layout" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="8dp" ns1:ignore="MissingClass">
        <androidx.core.widget.NestedScrollView android:id="@+id/scrollView" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="8dp" android:paddingBottom="16dp">
                <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/surface_dark">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_search" app:tint="@color/accent_cyan" />
                        <EditText android:id="@+id/search_bar" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="12dp" android:background="@android:color/transparent" android:fontFamily="@font/vazir_regular" android:hint="@string/search_hint" android:imeOptions="actionSearch" android:inputType="text" android:maxLines="1" android:singleLine="true" android:textColor="@color/text_white" android:textColorHint="@color/hint_search_color" android:textSize="14sp" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
                        <ImageView android:id="@+id/btn_voice_search" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_mic" android:visibility="gone" app:tint="@color/accent_cyan" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="-15dp" android:layout_marginBottom="16dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/surface_dark">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:id="@+id/txt_suggestions_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:paddingVertical="10dp" android:fontFamily="@font/vazir_regular" android:text="@string/search_suggestions" android:textColor="@color/accent_cyan" android:textSize="14sp" android:visibility="gone" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
                        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_search_suggestions" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxHeight="200dp" android:visibility="gone" ns1:listitem="@layout/item_search_suggestion" ns1:visibility="visible" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <LinearLayout android:id="@+id/catalog_empty_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_settings_card" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/catalog_unavailable" android:textColor="@color/text_white" android:textSize="14sp" android:gravity="start" android:fontFamily="@font/vazir_regular" app:fontFamily="@font/vazir_regular" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_retry_catalog" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/retry" android:textColor="@color/on_primary" android:fontFamily="@font/vazir_bold" app:fontFamily="@font/vazir_bold" app:backgroundTint="@color/primary_blue" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_marginTop="16dp" android:fontFamily="@font/vazir_bold" android:text="@string/featured_today" android:textColor="@color/text_white" android:textSize="18sp" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
                <androidx.cardview.widget.CardView android:id="@+id/featured_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/surface_dark">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/hero_editorial_bg">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="12dp">
                            <TextView android:id="@+id/hero_eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hero_eyebrow" android:textSize="12sp" android:textColor="@color/accent_cyan" android:fontFamily="@font/vazir_regular" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
                            <TextView android:id="@+id/txt_featured_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="21sp" android:textColor="@color/text_white" android:fontFamily="@font/vazir_bold" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="8dp" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
                            <TextView android:id="@+id/txt_featured_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="@color/text_gray" android:fontFamily="@font/vazir_regular" android:maxLines="1" android:ellipsize="end" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
                            <TextView android:id="@+id/hero_cta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hero_cta" android:textSize="14sp" android:textColor="@color/accent_cyan" android:fontFamily="@font/vazir_regular" android:layout_marginTop="12dp" android:minHeight="40dp" android:gravity="center_vertical" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
                        </LinearLayout>
                        <androidx.cardview.widget.CardView android:layout_width="104dp" android:layout_height="104dp" app:cardCornerRadius="16dp" app:cardElevation="0dp">
                            <ImageView android:id="@+id/img_featured" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/placeholder_podcast" android:importantForAccessibility="no" />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/vazir_bold" android:text="@string/trending_now" android:textColor="@color/text_white" android:textSize="17sp" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
                    <TextView android:id="@+id/btn_all_trending" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/vazir_regular" android:text="@string/view_all" android:textColor="@color/primary_blue" android:textSize="13sp" android:clickable="true" android:focusable="true" android:minHeight="48dp" android:gravity="center" android:paddingHorizontal="8dp" android:background="?attr/selectableItemBackground" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
                </LinearLayout>
                <com.facebook.shimmer.ShimmerFrameLayout android:id="@+id/shimmer_trending" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:visibility="gone" app:shimmer_auto_start="true" ns1:ignore="MissingClass">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <include layout="@layout/item_shimmer_podcast" />
                        <include layout="@layout/item_shimmer_podcast" />
                        <include layout="@layout/item_shimmer_podcast" />
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_trending" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:orientation="horizontal" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" ns1:listitem="@layout/item_podcast_trending" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_marginTop="16dp" android:fontFamily="@font/vazir_bold" android:text="@string/recommended_for_you" android:textColor="@color/text_white" android:textSize="17sp" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_recommended" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:orientation="horizontal" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" ns1:listitem="@layout/item_podcast_recommended" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/continue_section_header">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/vazir_bold" android:text="@string/continue_listening" android:textColor="@color/text_white" android:textSize="17sp" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
                    <TextView android:id="@+id/btn_all_resumes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/vazir_regular" android:text="@string/view_all" android:textColor="@color/primary_blue" android:textSize="13sp" android:clickable="true" android:focusable="true" android:minHeight="48dp" android:gravity="center" android:paddingHorizontal="8dp" android:background="?attr/selectableItemBackground" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
                </LinearLayout>
                <androidx.cardview.widget.CardView android:id="@+id/card_empty_continue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/surface_dark" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="28dp">
                        <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_empty_state" android:alpha="0.5" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:fontFamily="@font/vazir_bold" android:text="@string/no_continue_listening" android:textColor="@color/text_white" android:textSize="15sp" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="@font/vazir_regular" android:text="@string/no_continue_listening_desc" android:textColor="@color/text_gray" android:textSize="12sp" android:gravity="center" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
                        <Button android:id="@+id/btn_start_exploring" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_button_primary" android:fontFamily="@font/vazir_bold" android:paddingHorizontal="20dp" android:paddingVertical="8dp" android:text="@string/start_exploring" android:textColor="@color/on_primary" android:textSize="13sp" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_continue_listening" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:orientation="vertical" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" ns1:listitem="@layout/item_continue_podcast" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <ProgressBar android:id="@+id/progress_loading" style="?android:attr/progressBarStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" />
</FrameLayout>
