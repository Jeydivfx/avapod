<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layoutDirection="rtl" android:background="@color/background_dark">
    <include layout="@layout/layout_common_toolbar" android:id="@+id/common_toolbar" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/hero_editorial_bg" android:gravity="center_horizontal">
                <ImageView android:id="@+id/img_logo" android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_avapod_logo" android:importantForAccessibility="no" app:tint="@color/text_white" />
                <TextView android:id="@+id/txt_about_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/title_about" android:textSize="26sp" android:textColor="@color/text_white" android:fontFamily="@font/vazir_bold" android:gravity="center" android:lineSpacingExtra="3dp" app:fontFamily="@font/vazir_bold" android:layout_marginTop="12dp" />
                <TextView android:id="@+id/about_tagline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_tagline" android:textSize="14sp" android:textColor="@color/text_gray" android:fontFamily="@font/vazir_regular" android:gravity="center" android:lineSpacingExtra="3dp" app:fontFamily="@font/vazir_regular" />
                <TextView android:id="@+id/app_version_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_version" android:textSize="12sp" android:textColor="@color/text_gray" android:fontFamily="@font/vazir_regular" android:gravity="center" android:lineSpacingExtra="3dp" app:fontFamily="@font/vazir_regular" android:layout_marginTop="8dp" />
            </LinearLayout>
            <TextView android:id="@+id/about_intro_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/title_about_app" android:textSize="18sp" android:textColor="@color/text_white" android:fontFamily="@font/vazir_bold" android:gravity="start" android:lineSpacingExtra="3dp" app:fontFamily="@font/vazir_bold" android:layout_marginTop="24dp" />
            <TextView android:id="@+id/about_intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_intro" android:textSize="14sp" android:textColor="@color/text_gray" android:fontFamily="@font/vazir_regular" android:gravity="start" android:lineSpacingExtra="3dp" app:fontFamily="@font/vazir_regular" android:layout_marginTop="8dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="20dp" android:background="@drawable/bg_surface_rounded">
                <TextView android:id="@+id/about_contact_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_contact_heading" android:textSize="16sp" android:textColor="@color/text_white" android:fontFamily="@font/vazir_bold" android:gravity="start" android:lineSpacingExtra="3dp" app:fontFamily="@font/vazir_bold" />
                <TextView android:id="@+id/about_contact_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_contact_hint" android:textSize="14sp" android:textColor="@color/text_gray" android:fontFamily="@font/vazir_regular" android:gravity="start" android:lineSpacingExtra="3dp" app:fontFamily="@font/vazir_regular" android:layout_marginTop="6dp" />
                <TextView android:id="@+id/txt_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_contact_email" android:textSize="14sp" android:textColor="@color/text_gray" android:fontFamily="@font/vazir_regular" android:gravity="center" android:lineSpacingExtra="3dp" app:fontFamily="@font/vazir_regular" android:autoLink="email" android:textDirection="ltr" android:minHeight="48dp" android:textColorLink="@color/accent_cyan" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="16dp" android:background="@drawable/bg_surface_rounded">
                <TextView android:id="@+id/about_message_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_message_heading" android:textSize="16sp" android:textColor="@color/text_white" android:fontFamily="@font/vazir_bold" android:gravity="start" android:lineSpacingExtra="3dp" app:fontFamily="@font/vazir_bold" />
                <TextView android:id="@+id/txt_daily_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/default_daily_message" android:textSize="14sp" android:textColor="@color/text_gray" android:fontFamily="@font/vazir_regular" android:gravity="start" android:lineSpacingExtra="3dp" app:fontFamily="@font/vazir_regular" android:layout_marginTop="8dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/date_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="20dp" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView android:id="@+id/txt_shamsi_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/calendar_shamsi" android:textSize="12sp" android:textColor="@color/text_gray" android:fontFamily="@font/vazir_regular" android:gravity="center" android:lineSpacingExtra="3dp" app:fontFamily="@font/vazir_regular" />
                    <TextView android:id="@+id/txt_shamsi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="12sp" android:textColor="@color/text_gray" android:fontFamily="@font/vazir_regular" android:gravity="center" android:lineSpacingExtra="3dp" app:fontFamily="@font/vazir_regular" android:textDirection="ltr" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView android:id="@+id/txt_miladi_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/calendar_miladi" android:textSize="12sp" android:textColor="@color/text_gray" android:fontFamily="@font/vazir_regular" android:gravity="center" android:lineSpacingExtra="3dp" app:fontFamily="@font/vazir_regular" />
                    <TextView android:id="@+id/txt_miladi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="12sp" android:textColor="@color/text_gray" android:fontFamily="@font/vazir_regular" android:gravity="center" android:lineSpacingExtra="3dp" app:fontFamily="@font/vazir_regular" android:textDirection="ltr" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>