<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layoutDirection="rtl" android:background="@color/background_dark">
    <include layout="@layout/layout_common_toolbar" android:id="@+id/common_toolbar" android:visibility="gone" />
    <TextView android:id="@+id/txt_title_library" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/title_library" android:textSize="24sp" android:fontFamily="@font/vazir_bold" android:textColor="@color/text_white" android:gravity="start" android:paddingHorizontal="20dp" android:paddingTop="16dp" android:paddingBottom="12dp" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
    <androidx.coordinatorlayout.widget.CoordinatorLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/background_dark" app:elevation="0dp">
            <LinearLayout android:id="@+id/library_shortcuts" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" app:layout_scrollFlags="scroll|exitUntilCollapsed">
                <TextView android:id="@+id/library_intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/personal_space_intro" android:textSize="14sp" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_gray" android:gravity="start" android:paddingBottom="20dp" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_surface_rounded">
                    <LinearLayout android:id="@+id/library_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_access_time" android:background="@drawable/bg_circle_dark" android:importantForAccessibility="no" app:tint="@color/accent_cyan" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginHorizontal="12dp">
                            <TextView android:id="@+id/library_history_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/continue_listening" android:textSize="15sp" android:fontFamily="@font/vazir_bold" android:textColor="@color/text_white" android:gravity="start" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
                            <TextView android:id="@+id/library_history_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/personal_resume_hint" android:textSize="12sp" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_gray" android:gravity="start" android:layout_marginTop="3dp" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_left" android:importantForAccessibility="no" app:tint="@color/text_gray" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/line_divider_bg" android:importantForAccessibility="no" />
                    <LinearLayout android:id="@+id/library_downloads" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_download" android:background="@drawable/bg_circle_dark" android:importantForAccessibility="no" app:tint="@color/accent_cyan" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginHorizontal="12dp">
                            <TextView android:id="@+id/library_downloads_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_downloads" android:textSize="15sp" android:fontFamily="@font/vazir_bold" android:textColor="@color/text_white" android:gravity="start" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
                            <TextView android:id="@+id/library_downloads_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/personal_download_hint" android:textSize="12sp" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_gray" android:gravity="start" android:layout_marginTop="3dp" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_left" android:importantForAccessibility="no" app:tint="@color/text_gray" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/line_divider_bg" android:importantForAccessibility="no" />
                    <LinearLayout android:id="@+id/library_bookmarks" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_bookmark" android:background="@drawable/bg_circle_dark" android:importantForAccessibility="no" app:tint="@color/accent_cyan" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginHorizontal="12dp">
                            <TextView android:id="@+id/library_bookmarks_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/title_bookmarks" android:textSize="15sp" android:fontFamily="@font/vazir_bold" android:textColor="@color/text_white" android:gravity="start" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
                            <TextView android:id="@+id/library_bookmarks_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/personal_bookmark_hint" android:textSize="12sp" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_gray" android:gravity="start" android:layout_marginTop="3dp" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_left" android:importantForAccessibility="no" app:tint="@color/text_gray" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/line_divider_bg" android:importantForAccessibility="no" />
                    <LinearLayout android:id="@+id/library_new_episodes" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_notifications" android:background="@drawable/bg_circle_dark" android:importantForAccessibility="no" app:tint="@color/accent_cyan" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginHorizontal="12dp">
                            <TextView android:id="@+id/library_new_episodes_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_new_episodes" android:textSize="15sp" android:fontFamily="@font/vazir_bold" android:textColor="@color/text_white" android:gravity="start" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
                            <TextView android:id="@+id/library_new_episodes_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/personal_new_hint" android:textSize="12sp" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_gray" android:gravity="start" android:layout_marginTop="3dp" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_left" android:importantForAccessibility="no" app:tint="@color/text_gray" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/library_following_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/library_following" android:textSize="18sp" android:fontFamily="@font/vazir_bold" android:textColor="@color/text_white" android:gravity="start" android:paddingTop="24dp" android:paddingBottom="12dp" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_library" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="12dp" android:paddingBottom="20dp" android:clipToPadding="false" app:layout_behavior="@string/appbar_scrolling_view_behavior" />
        <TextView android:id="@+id/txt_empty_library" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/personal_empty_following" android:textSize="14sp" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_gray" android:gravity="center" android:padding="24dp" android:visibility="gone" app:layout_behavior="@string/appbar_scrolling_view_behavior" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>