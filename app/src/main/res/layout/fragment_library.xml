<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layoutDirection="rtl" android:background="@color/background_dark">
  <include layout="@layout/layout_common_toolbar" android:id="@+id/common_toolbar" android:visibility="gone"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="16dp" android:paddingBottom="12dp"><TextView android:id="@+id/txt_title_library" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/title_library" android:textSize="@dimen/type_title" android:fontFamily="@font/vazir_bold" android:textColor="@color/text_white" android:gravity="start" android:paddingHorizontal="20dp" android:paddingTop="16dp" android:paddingBottom="12dp" app:fontFamily="@font/vazir_bold" android:textStyle="normal" android:layout_weight="1" android:padding="0dp"/>
  <FrameLayout android:layout_width="40dp" android:layout_height="40dp"><ImageButton android:id="@+id/library_notifications" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle_dark" android:src="@drawable/ic_bell_outline" android:padding="9dp" android:contentDescription="@string/inbox_title" app:tint="@color/primary_blue"/><View android:id="@+id/library_unread_dot" android:layout_width="8dp" android:layout_height="8dp" android:layout_gravity="top|end" android:layout_marginTop="4dp" android:layout_marginEnd="4dp" android:background="@drawable/home_unread_dot" android:visibility="gone"/></FrameLayout></LinearLayout><androidx.core.widget.NestedScrollView android:id="@+id/library_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <LinearLayout android:id="@+id/library_shortcuts" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp">
        <TextView android:id="@+id/library_intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/personal_space_intro" android:textSize="@dimen/type_body" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_gray" android:gravity="start" android:paddingBottom="20dp" app:fontFamily="@font/vazir_regular" android:textStyle="normal"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_surface_rounded">
          <LinearLayout android:id="@+id/library_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_access_time" android:background="@drawable/bg_circle_dark" android:importantForAccessibility="no" app:tint="@color/accent_cyan"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginHorizontal="12dp">
              <TextView android:id="@+id/library_history_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/continue_listening" android:textSize="@dimen/type_label" android:fontFamily="@font/vazir_bold" android:textColor="@color/text_white" android:gravity="start" app:fontFamily="@font/vazir_bold" android:textStyle="normal"/>
              <TextView android:id="@+id/library_history_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/personal_resume_hint" android:textSize="@dimen/type_caption" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_gray" android:gravity="start" android:layout_marginTop="3dp" app:fontFamily="@font/vazir_regular" android:textStyle="normal"/>
            </LinearLayout>
            <ImageView android:layout_width="@dimen/icon_inline" android:layout_height="@dimen/icon_inline" android:src="@drawable/ic_chevron_left" android:importantForAccessibility="no" app:tint="@color/text_gray"/>
          </LinearLayout>
          <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/line_divider_bg" android:importantForAccessibility="no"/>
          <LinearLayout android:id="@+id/library_downloads" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_download" android:background="@drawable/bg_circle_dark" android:importantForAccessibility="no" app:tint="@color/accent_cyan"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginHorizontal="12dp">
              <TextView android:id="@+id/library_downloads_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_downloads" android:textSize="@dimen/type_label" android:fontFamily="@font/vazir_bold" android:textColor="@color/text_white" android:gravity="start" app:fontFamily="@font/vazir_bold" android:textStyle="normal"/>
              <TextView android:id="@+id/library_downloads_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/personal_download_hint" android:textSize="@dimen/type_caption" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_gray" android:gravity="start" android:layout_marginTop="3dp" app:fontFamily="@font/vazir_regular" android:textStyle="normal"/>
            </LinearLayout>
            <ImageView android:layout_width="@dimen/icon_inline" android:layout_height="@dimen/icon_inline" android:src="@drawable/ic_chevron_left" android:importantForAccessibility="no" app:tint="@color/text_gray"/>
          </LinearLayout>
          <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/line_divider_bg" android:importantForAccessibility="no"/>
          <LinearLayout android:id="@+id/library_bookmarks" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_bookmark" android:background="@drawable/bg_circle_dark" android:importantForAccessibility="no" app:tint="@color/accent_cyan"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginHorizontal="12dp">
              <TextView android:id="@+id/library_bookmarks_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/title_bookmarks" android:textSize="@dimen/type_label" android:fontFamily="@font/vazir_bold" android:textColor="@color/text_white" android:gravity="start" app:fontFamily="@font/vazir_bold" android:textStyle="normal"/>
              <TextView android:id="@+id/library_bookmarks_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/personal_bookmark_hint" android:textSize="@dimen/type_caption" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_gray" android:gravity="start" android:layout_marginTop="3dp" app:fontFamily="@font/vazir_regular" android:textStyle="normal"/>
            </LinearLayout>
            <ImageView android:layout_width="@dimen/icon_inline" android:layout_height="@dimen/icon_inline" android:src="@drawable/ic_chevron_left" android:importantForAccessibility="no" app:tint="@color/text_gray"/>
          </LinearLayout>
          <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/line_divider_bg" android:importantForAccessibility="no"/>
          <LinearLayout android:id="@+id/library_new_episodes" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_notifications" android:background="@drawable/bg_circle_dark" android:importantForAccessibility="no" app:tint="@color/accent_cyan"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginHorizontal="12dp">
              <TextView android:id="@+id/library_new_episodes_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_new_episodes" android:textSize="@dimen/type_label" android:fontFamily="@font/vazir_bold" android:textColor="@color/text_white" android:gravity="start" app:fontFamily="@font/vazir_bold" android:textStyle="normal"/>
              <TextView android:id="@+id/library_new_episodes_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/personal_new_hint" android:textSize="@dimen/type_caption" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_gray" android:gravity="start" android:layout_marginTop="3dp" app:fontFamily="@font/vazir_regular" android:textStyle="normal"/>
            </LinearLayout>
            <ImageView android:layout_width="@dimen/icon_inline" android:layout_height="@dimen/icon_inline" android:src="@drawable/ic_chevron_left" android:importantForAccessibility="no" app:tint="@color/text_gray"/>
          </LinearLayout>
          <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/line_divider_bg" android:importantForAccessibility="no"/>
        <LinearLayout android:id="@+id/library_playlist" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="@android:color/transparent" android:foreground="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
          <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_playlist_add" android:background="@drawable/bg_circle_dark" app:tint="@color/accent_cyan" android:importantForAccessibility="no"/>
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginHorizontal="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/playlist_title" android:textSize="@dimen/type_label" android:fontFamily="@font/vazir_bold" android:textColor="@color/text_white"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/playlist_hint" android:textSize="@dimen/type_caption" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_gray" android:layout_marginTop="3dp"/>
