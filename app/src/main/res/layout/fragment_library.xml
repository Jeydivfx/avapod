          <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_left" app:tint="@color/text_gray" android:importantForAccessibility="no"/>
        </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/library_following_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/library_following" android:textSize="@dimen/type_section" android:fontFamily="@font/vazir_bold" android:textColor="@color/text_white" android:gravity="start" android:paddingTop="24dp" android:paddingBottom="12dp" app:fontFamily="@font/vazir_bold" android:textStyle="normal"/>
      </LinearLayout>
      <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_library" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:paddingBottom="20dp" android:clipToPadding="false" android:nestedScrollingEnabled="false"/>
      <TextView android:id="@+id/txt_empty_library" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/personal_empty_following" android:textSize="@dimen/type_body" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_gray" android:gravity="center" android:padding="24dp" android:visibility="gone" app:fontFamily="@font/vazir_regular" android:textStyle="normal"/>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</LinearLayout>