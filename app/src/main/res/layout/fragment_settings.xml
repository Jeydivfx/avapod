<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:layoutDirection="rtl" android:background="@color/background_dark">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/background_dark" android:padding="12dp" android:layoutDirection="rtl">
        <include android:id="@+id/common_toolbar" layout="@layout/layout_common_toolbar" />
        <TextView android:id="@+id/txt_settings_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/common_toolbar" android:fontFamily="@font/vazir_bold" android:text="@string/nav_settings" android:textColor="@color/text_white" android:textSize="20sp" android:gravity="right" android:layout_marginHorizontal="4dp" android:layout_marginTop="8dp" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
        <LinearLayout android:id="@+id/layout_appearance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/txt_settings_title" android:layout_marginTop="20dp" android:layout_marginHorizontal="12dp" android:background="@drawable/bg_settings_card" android:orientation="horizontal" android:padding="14dp" android:minHeight="64dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layoutDirection="rtl" android:gravity="center_vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="12dp" android:src="@drawable/ic_settings_appearance" android:importantForAccessibility="no" android:focusable="false" app:tint="@color/icon_tint" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_appearance" android:textColor="@color/text_white" android:textSize="14sp" android:fontFamily="@font/vazir_bold" app:fontFamily="@font/vazir_bold" android:gravity="start" />
                <TextView android:id="@+id/txt_appearance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_gray" android:textSize="12sp" android:fontFamily="@font/vazir_regular" app:fontFamily="@font/vazir_regular" android:gravity="start" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/layout_clear_cache" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/layout_appearance" android:layout_marginTop="12dp" android:layout_marginHorizontal="12dp" android:background="@drawable/bg_settings_card" android:padding="14dp" android:clickable="true" android:focusable="true" android:orientation="horizontal" android:gravity="center_vertical" android:layoutDirection="rtl" android:minHeight="64dp" android:foreground="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="12dp" android:src="@drawable/ic_settings_cache" android:importantForAccessibility="no" android:focusable="false" app:tint="@color/icon_tint" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings_clear_cache" android:textColor="@color/text_white" android:textSize="14sp" android:fontFamily="@font/vazir_regular" android:textStyle="normal" android:gravity="start|center_vertical" app:fontFamily="@font/vazir_regular" />
        </LinearLayout>
        <LinearLayout android:id="@+id/layout_clear_downloads" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/layout_clear_cache" android:layout_marginTop="12dp" android:layout_marginHorizontal="12dp" android:background="@drawable/bg_settings_card" android:padding="14dp" android:clickable="true" android:focusable="true" android:orientation="horizontal" android:gravity="center_vertical" android:layoutDirection="rtl" android:minHeight="64dp" android:foreground="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="12dp" android:src="@drawable/ic_settings_delete" android:importantForAccessibility="no" android:focusable="false" app:tint="@color/icon_tint" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings_clear_downloads" android:textColor="@color/text_white" android:textSize="14sp" android:fontFamily="@font/vazir_regular" android:textStyle="normal" android:gravity="start|center_vertical" app:fontFamily="@font/vazir_regular" />
        </LinearLayout>
        <LinearLayout android:id="@+id/layout_sleep_timer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/layout_clear_downloads" android:layout_marginTop="12dp" android:layout_marginHorizontal="12dp" android:background="@drawable/bg_settings_card" android:padding="14dp" android:clickable="true" android:focusable="true" android:orientation="horizontal" android:gravity="center_vertical" android:layoutDirection="rtl" android:minHeight="64dp" android:foreground="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="12dp" android:src="@drawable/ic_settings_clock" android:importantForAccessibility="no" android:focusable="false" app:tint="@color/icon_tint" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings_sleep_timer" android:textColor="@color/text_white" android:textSize="14sp" android:fontFamily="@font/vazir_regular" android:textStyle="normal" android:gravity="start|center_vertical" app:fontFamily="@font/vazir_regular" />
            <TextView android:id="@+id/txt_timer_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/timer_status_off" android:textColor="@color/accent_cyan" android:fontFamily="@font/vazir_regular" android:textSize="12sp" app:fontFamily="@font/vazir_regular" android:textStyle="normal" android:layout_marginStart="12dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/layout_about" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/layout_sleep_timer" android:layout_marginTop="12dp" android:layout_marginHorizontal="12dp" android:background="@drawable/bg_settings_card" android:orientation="vertical">
            <LinearLayout android:id="@+id/btn_about_app" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical" android:background="@android:color/transparent" android:clickable="true" android:focusable="true" android:orientation="horizontal" android:layoutDirection="rtl" android:padding="14dp" android:foreground="?attr/selectableItemBackground">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="12dp" android:src="@drawable/ic_settings_info" android:importantForAccessibility="no" android:focusable="false" app:tint="@color/icon_tint" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/about_app_link" android:textColor="@color/text_white" android:textSize="14sp" android:fontFamily="@font/vazir_regular" android:textStyle="normal" android:gravity="start|center_vertical" app:fontFamily="@font/vazir_regular" />
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_chevron_left" android:importantForAccessibility="no" android:focusable="false" app:tint="@color/text_gray" android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/txt_app_version" android:layout_below="@id/layout_about" android:layout_centerHorizontal="true" android:layout_marginTop="4dp" android:clickable="true" android:focusable="true" android:minHeight="48dp" android:minWidth="96dp" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_version" android:textColor="@color/text_gray" android:fontFamily="@font/vazir_regular" android:textSize="12sp" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
    </RelativeLayout>
</androidx.core.widget.NestedScrollView>