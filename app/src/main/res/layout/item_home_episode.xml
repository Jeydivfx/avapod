<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingEnd="5dp" android:orientation="vertical" android:layoutDirection="rtl" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
  <androidx.cardview.widget.CardView android:id="@+id/home_cover_frame" android:layout_width="match_parent" android:layout_height="100dp" app:cardCornerRadius="12dp" app:cardElevation="0dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="ltr">
      <ImageView android:id="@+id/home_card_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no" />
      <TextView android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="bottom|left" android:layout_margin="4dp" android:background="@drawable/home_glass_bg" android:gravity="center" android:text="▶" android:textColor="#FFFFFF" android:textSize="@dimen/type_body" android:importantForAccessibility="no" />
      <TextView android:id="@+id/home_card_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|right" android:layout_margin="4dp" android:paddingHorizontal="4dp" android:paddingVertical="1dp" android:background="@drawable/home_glass_bg" android:textColor="#FFFFFF" android:textSize="10sp" android:fontFamily="@font/vazir_regular" android:maxLines="1" android:includeFontPadding="false" />
    </FrameLayout>
  </androidx.cardview.widget.CardView>
  <TextView android:id="@+id/home_card_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/home_space_8" android:textSize="12sp" android:fontFamily="@font/vazir_bold" android:textColor="@color/text_white" android:maxLines="1" android:ellipsize="end" android:gravity="right" android:includeFontPadding="false" android:minLines="1" />
  <TextView android:id="@+id/home_card_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="@dimen/type_caption" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_gray" android:maxLines="1" android:ellipsize="end" android:gravity="right" android:includeFontPadding="false" />
</LinearLayout>