<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:layoutDirection="rtl" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp" android:background="@drawable/bg_settings_card">
<LinearLayout android:id="@+id/playlist_row_play" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="72dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
<androidx.cardview.widget.CardView android:layout_width="56dp" android:layout_height="56dp" app:cardCornerRadius="10dp" app:cardElevation="0dp"><FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"><ImageView android:id="@+id/playlist_row_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no" /><ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="bottom|left" android:layout_margin="3dp" android:padding="4dp" android:src="@drawable/ic_play_arrow" android:background="@drawable/home_glass_bg" app:tint="@android:color/white" android:importantForAccessibility="no" /></FrameLayout></androidx.cardview.widget.CardView>
