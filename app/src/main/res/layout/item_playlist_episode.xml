<TextView android:id="@+id/playlist_row_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/text_gray" android:textSize="@dimen/type_caption" android:fontFamily="@font/vazir_regular" />
</LinearLayout></LinearLayout>
<ImageButton android:id="@+id/playlist_row_remove" android:layout_width="48dp" android:layout_height="48dp" android:padding="15dp" android:src="@drawable/ic_playlist_delete" app:tint="@color/text_gray" android:contentDescription="@string/playlist_delete" android:background="?attr/selectableItemBackgroundBorderless" />
</LinearLayout>