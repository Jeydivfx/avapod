<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="12dp">

    <include
        android:id="@+id/common_toolbar"
        layout="@layout/layout_common_toolbar" />

    <TextView
        android:id="@+id/txt_new_episodes_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/common_toolbar"
        android:layout_marginEnd="24dp"
        android:layout_marginStart="24dp"
        android:fontFamily="@font/vazir_bold"
        android:text="@string/title_new_episodes"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:gravity="right"
        android:textDirection="rtl" />


    <TextView
        android:id="@+id/txt_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="@string/error_no_subscriptions"
        android:textColor="@color/text_gray"
        android:fontFamily="@font/vazir_regular"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_new_episodes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/txt_new_episodes_title"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp" />

    <ProgressBar
        android:id="@+id/loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

</RelativeLayout>