<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:id="@+id/img_recommended_cover"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_podcast"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/txt_recommended_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/vazir_bold"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="پادکست پیشنهادی" />

        <TextView
            android:id="@+id/txt_recommended_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/vazir_regular"
            android:textColor="@color/text_gray"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="گوینده" />
    </LinearLayout>
</androidx.cardview.widget.CardView>