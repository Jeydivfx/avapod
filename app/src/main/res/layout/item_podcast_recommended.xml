<?xml version='1.0' encoding='UTF-8'?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:ns2="http://schemas.android.com/tools" android:layout_width="112dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/surface_dark">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp">
    <ImageView android:id="@+id/img_recommended_cover" android:layout_width="match_parent" android:layout_height="96dp" android:scaleType="centerCrop" android:src="@drawable/ic_podcast" android:contentDescription="@string/app_name"/>
    <TextView android:id="@+id/txt_recommended_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="@font/vazir_bold" android:textColor="@color/text_white" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" ns2:text="پادکست پیشنهادی" app:fontFamily="@font/vazir_bold" android:textStyle="normal"/>
    <TextView android:id="@+id/txt_recommended_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_gray" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" ns2:text="گوینده" app:fontFamily="@font/vazir_regular" android:textStyle="normal"/>
  </LinearLayout>
</androidx.cardview.widget.CardView>
