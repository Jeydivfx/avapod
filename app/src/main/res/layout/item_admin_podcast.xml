      <com.google.android.material.button.MaterialButton android:id="@+id/btn_delete_admin" android:layout_width="wrap_content" android:fontFamily="@font/vazir_regular" android:layout_height="40dp" android:layout_marginStart="8dp" android:textColor="@color/on_primary" android:text="@string/action_delete" android:textSize="@dimen/type_caption" app:cornerRadius="8dp" app:backgroundTint="#D32F2F" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
    </LinearLayout>
  </LinearLayout>
</androidx.cardview.widget.CardView>