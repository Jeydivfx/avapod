<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazir_bold"
        android:gravity="right"
        android:text="@string/dialog_clear_downloads_title"
        android:textColor="@color/text_white"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/vazir_regular"
        android:gravity="right"
        android:lineSpacingMultiplier="1.2"
        android:text="@string/dialog_clear_downloads_message"
        android:textColor="@color/text_gray"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="right"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_negative"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/vazir_bold"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/dialog_no"
            android:textColor="@color/dialog_button_negative"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btn_positive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/vazir_bold"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/dialog_yes"
            android:textColor="@color/primary_blue"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>