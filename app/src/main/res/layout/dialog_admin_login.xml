<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@color/login_field">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/title_admin_login" android:textColor="@color/text_white" android:fontFamily="@font/vazir_bold" android:textSize="18sp" android:gravity="center" android:layout_marginBottom="20dp" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
    <EditText android:id="@+id/edt_admin_user" android:layout_width="match_parent" android:layout_height="50dp" android:hint="@string/admin_username_or_email" android:inputType="textVisiblePassword" android:singleLine="true" android:autofillHints="username" android:background="@drawable/bg_settings_card" android:textColor="@color/text_white" android:textColorHint="@color/text_gray" android:paddingHorizontal="12dp" android:gravity="right|center_vertical" android:layout_marginBottom="12dp" android:fontFamily="@font/vazir_regular" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
    <EditText android:id="@+id/edt_admin_pass" android:layout_width="match_parent" android:layout_height="50dp" android:hint="@string/hint_password" android:inputType="textPassword" android:background="@drawable/bg_settings_card" android:textColor="@color/text_white" android:textColorHint="@color/text_gray" android:paddingHorizontal="12dp" android:gravity="right|center_vertical" android:layout_marginBottom="20dp" android:fontFamily="@font/vazir_regular" app:fontFamily="@font/vazir_regular" android:textStyle="normal" />
    <Button android:id="@+id/btn_dialog_login" android:layout_width="match_parent" android:layout_height="50dp" android:text="@string/btn_login" android:backgroundTint="@color/primary_blue" android:textColor="@color/on_primary" android:fontFamily="@font/vazir_bold" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
</LinearLayout>