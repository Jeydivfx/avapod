<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="ltr" android:clipChildren="true">
  <androidx.cardview.widget.CardView android:id="@+id/hero_cover_frame" android:layout_width="120dp" android:layout_height="120dp" android:layout_gravity="left|center_vertical" android:layout_marginLeft="12dp" app:cardCornerRadius="15dp" app:cardElevation="0dp">
    <ImageView android:id="@+id/hero_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
  </androidx.cardview.widget.CardView>
  <LinearLayout android:id="@+id/hero_content_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginLeft="144dp" android:layout_marginRight="12dp" android:layoutDirection="ltr" android:orientation="vertical" android:gravity="center_vertical|right" android:paddingVertical="4dp">
    <TextView android:id="@+id/hero_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="right" android:gravity="center" android:paddingHorizontal="9dp" android:text="@string/home_featured_badge" android:textColor="#FFFFFF" android:textSize="10sp" android:fontFamily="@font/vazir_bold" android:includeFontPadding="false" android:layout_marginTop="0dp" android:maxLines="1" android:paddingVertical="3dp" />
    <TextView android:id="@+id/hero_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="right" android:gravity="right|center_vertical" android:layoutDirection="rtl" android:textSize="16sp" android:textColor="#FFFFFF" android:fontFamily="@font/vazir_bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="2dp" />
    <TextView android:id="@+id/hero_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="right" android:gravity="right|center_vertical" android:layoutDirection="rtl" android:textSize="10sp" android:textColor="#C1BECD" android:fontFamily="@font/vazir_regular" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="8dp" />
    <FrameLayout android:id="@+id/hero_listen" android:layout_width="116dp" android:layout_height="48dp" android:layout_gravity="right" android:layoutDirection="rtl" android:gravity="center" android:clickable="true" android:focusable="true" android:contentDescription="@string/home_listen">
      <LinearLayout android:id="@+id/hero_listen_surface" android:layout_width="match_parent" android:layout_height="30dp" android:layout_gravity="center" android:gravity="center" android:orientation="horizontal" android:layoutDirection="ltr">
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/hero_play_black" android:importantForAccessibility="no" android:tint="#FFFFFF" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hero_listen_label" android:textSize="12sp" android:textColor="#FFFFFF" android:fontFamily="@font/vazir_bold" android:includeFontPadding="false" android:layout_marginStart="6dp" android:maxLines="1" android:ellipsize="end" />
      </LinearLayout>
    </FrameLayout>
  </LinearLayout>
</FrameLayout>