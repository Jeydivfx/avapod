<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_dark" android:padding="12dp" android:layoutDirection="rtl">
    <include android:id="@+id/common_toolbar" layout="@layout/layout_common_toolbar" />
    <TextView android:id="@+id/txt_explore_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/common_toolbar" android:fontFamily="@font/vazir_bold" android:text="@string/title_categories" android:textColor="@color/text_white" android:textSize="20sp" android:gravity="right" android:textDirection="rtl" android:layout_marginHorizontal="4dp" android:layout_marginTop="8dp" app:fontFamily="@font/vazir_bold" android:textStyle="normal" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_categories" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/txt_explore_title" android:layout_marginTop="12dp" android:clipToPadding="false" android:paddingBottom="20dp" />
    <ProgressBar android:id="@+id/loader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:visibility="gone" />
</RelativeLayout>